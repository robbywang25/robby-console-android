    <item android:id="@android:id/background"><shape><solid android:color="@color/widget_track" /><corners android:radius="2dp" /></shape></item>
    <item android:id="@android:id/progress"><clip><shape><solid android:color="@color/widget_ok" /><corners android:radius="2dp" /></shape></clip></item>
</layer-list>
