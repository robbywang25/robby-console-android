<?xml version="1.0" encoding="utf-8"?>
<!-- The widget card: a faint top-to-bottom sheen and a hairline rim, like the app's content cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/widget_surface_top" android:endColor="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_rim" />
    <corners android:radius="22dp" />
</shape>
