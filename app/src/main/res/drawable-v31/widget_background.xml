<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the launcher's own widget corner radius, so God's cards line up with the system's. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="@color/widget_surface_top" android:endColor="@color/widget_surface" />
    <stroke android:width="1dp" android:color="@color/widget_rim" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
