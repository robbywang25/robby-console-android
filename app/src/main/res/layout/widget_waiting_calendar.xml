<?xml version="1.0" encoding="utf-8"?>
<!-- 重置日历 before God draws it: the launcher shows this initialLayout until the first update, and ColorOS falls back to it
     after God is updated. The name and 「待更新」 tell the owner it is waiting, not broken; it carries no account data. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp" android:text="@string/widget_calendar_title"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_pending"
            android:textSize="11sp" android:textColor="@color/widget_warn" android:singleLine="true" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="@string/widget_waiting"
        android:textSize="12sp" android:textColor="@color/widget_muted" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
