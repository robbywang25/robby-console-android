<?xml version="1.0" encoding="utf-8"?>
<!-- 重置日历: the next resets as day, time and platform with its window; the day is written once per day. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="9dp">
        <TextView android:id="@+id/wk_day1" android:layout_width="38dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextView android:id="@+id/wk_time1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:paddingStart="0dp" android:paddingEnd="8dp" android:fontFeatureSettings="tnum"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wk_dot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:visibility="gone" />
        <TextView android:id="@+id/wk_text1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_open"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/wk_day2" android:layout_width="38dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextView android:id="@+id/wk_time2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:paddingStart="0dp" android:paddingEnd="8dp" android:fontFeatureSettings="tnum"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wk_dot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:visibility="gone" />
        <TextView android:id="@+id/wk_text2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/wk_day3" android:layout_width="38dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextView android:id="@+id/wk_time3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:paddingStart="0dp" android:paddingEnd="8dp" android:fontFeatureSettings="tnum"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wk_dot3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:visibility="gone" />
        <TextView android:id="@+id/wk_text3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/wk_day4" android:layout_width="38dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextView android:id="@+id/wk_time4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:paddingStart="0dp" android:paddingEnd="8dp" android:fontFeatureSettings="tnum"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wk_dot4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:visibility="gone" />
        <TextView android:id="@+id/wk_text4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wk_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp" android:visibility="gone">
        <TextView android:id="@+id/wk_day5" android:layout_width="38dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextView android:id="@+id/wk_time5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="46dp" android:paddingStart="0dp" android:paddingEnd="8dp" android:fontFeatureSettings="tnum"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wk_dot5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:visibility="gone" />
        <TextView android:id="@+id/wk_text5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
