<?xml version="1.0" encoding="utf-8"?>
<!-- God 小组件 for the home screen and the lock screen: the app mark and public Tibo news only, never account data.
     The card wraps its content and sits centred, so a large lock-screen cell does not blow it up; a live countdown
     takes the right side in large figures. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/widget_frame"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@android:id/background" tools:ignore="UselessParent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="14dp" android:paddingTop="9dp" android:paddingBottom="9dp"
        android:background="@drawable/widget_background">
        <ImageView android:id="@+id/widget_icon" android:layout_width="34dp" android:layout_height="34dp" android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="8dp">
            <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_title"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
            <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open"
                android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        </LinearLayout>
        <Chronometer android:id="@+id/widget_countdown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" android:fontFeatureSettings="tnum"
            android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_alert" android:singleLine="true" />
    </LinearLayout>
</FrameLayout>
