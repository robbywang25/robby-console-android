<?xml version="1.0" encoding="utf-8"?>
<!-- 运行状态 and 微信消息: one large figure with its unit, and a status line with an optional colour dot. No names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wf_space" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="true">
        <TextView android:id="@+id/wf_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_none" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
            android:textSize="36sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        <TextView android:id="@+id/wf_unit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="4dp" android:paddingEnd="0dp"
            android:textSize="13sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <ProgressBar android:id="@+id/wf_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
        <TextView android:id="@+id/wf_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="5dp" android:text="@string/widget_dot" android:importantForAccessibility="no"
            android:textSize="11sp" android:textColor="@color/widget_ok" android:visibility="gone" />
        <TextView android:id="@+id/wf_line" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
