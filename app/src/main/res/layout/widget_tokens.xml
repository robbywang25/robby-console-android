<?xml version="1.0" encoding="utf-8"?>
<!-- Token 额度: up to six accounts, each a name, its reset time, the tightest remaining percent and a bar. No emails or ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="9dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wt_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp" android:text="@string/widget_open"
                android:textSize="13sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/wt_reset1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="8dp"
                android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            <TextView android:id="@+id/wt_pct1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar1" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wt_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
                android:textSize="13sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/wt_reset2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="8dp"
                android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            <TextView android:id="@+id/wt_pct2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar2" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
