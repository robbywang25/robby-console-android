            <TextView android:id="@+id/wt_pct3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar3" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wt_name4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
                android:textSize="13sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/wt_reset4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="8dp"
                android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            <TextView android:id="@+id/wt_pct4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar4" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wt_name5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
                android:textSize="13sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/wt_reset5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="8dp"
                android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            <TextView android:id="@+id/wt_pct5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar5" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wt_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/wt_name6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
                android:textSize="13sp" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
            <TextView android:id="@+id/wt_reset6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="8dp"
