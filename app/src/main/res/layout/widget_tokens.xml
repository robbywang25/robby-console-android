            <TextView android:id="@+id/wt_pct6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
        </LinearLayout>
        <ProgressBar android:id="@+id/wt_bar6" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="5dp"
            android:max="100" android:progressDrawable="@drawable/widget_bar" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
