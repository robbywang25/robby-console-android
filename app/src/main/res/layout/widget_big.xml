<?xml version="1.0" encoding="utf-8"?>
<!-- 运行状态 and 微信消息: one large figure with a line under it and the reading time; no names. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wb_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="8dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/wb_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
    <TextView android:id="@+id/wb_value" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom" android:text="@string/widget_open"
        android:textSize="24sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/wb_line" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/wb_footer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom"
        android:textSize="11sp" android:textColor="@color/widget_muted" android:singleLine="true" />
</LinearLayout>
