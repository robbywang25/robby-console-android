<?xml version="1.0" encoding="utf-8"?>
<!-- 时区时钟, tall: the first clock large with its weekday, the next two side by side under a hairline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/wc_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
            <TextClock android:id="@+id/wc_day1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format24Hour="M月d日 EEE" android:format12Hour="M月d日 EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        </LinearLayout>
        <TextClock android:id="@+id/wc_clock1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum" android:includeFontPadding="false"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="40sp" android:textColor="@color/widget_ink" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <FrameLayout android:id="@+id/wc_rule" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="6dp" android:layout_marginBottom="7dp" android:background="@color/widget_track" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
        <LinearLayout android:id="@+id/wc_row2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wc_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="4dp"
                    android:textSize="11sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
                <TextClock android:id="@+id/wc_day2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="EEE" android:format12Hour="EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            </LinearLayout>
            <TextClock android:id="@+id/wc_clock2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
        </LinearLayout>
        <LinearLayout android:id="@+id/wc_row3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/wc_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="4dp"
                    android:textSize="11sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
                <TextClock android:id="@+id/wc_day3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:format24Hour="EEE" android:format12Hour="EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
            </LinearLayout>
            <TextClock android:id="@+id/wc_clock3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
                android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
