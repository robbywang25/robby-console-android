<?xml version="1.0" encoding="utf-8"?>
<!-- Token 额度 and 重置日历: a title, up to six fixed lines and the reading time. Account emails and ids never reach here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wr_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="9dp" android:paddingBottom="8dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/wr_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" />
    <TextView android:id="@+id/wr_row1" style="@style/WidgetRow" android:text="@string/widget_open" />
    <TextView android:id="@+id/wr_row2" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/wr_row3" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/wr_row4" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/wr_row5" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/wr_row6" style="@style/WidgetRow" android:visibility="gone" />
    <TextView android:id="@+id/wr_footer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="bottom"
        android:textSize="11sp" android:textColor="@color/widget_muted" android:singleLine="true" />
</LinearLayout>
