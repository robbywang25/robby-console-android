<?xml version="1.0" encoding="utf-8"?>
<!-- 时区时钟: the first three clocks of 编辑看板, each a TextClock in its own zone, so nothing has to run to keep time. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/wc_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/wc_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wc_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_clock1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wc_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_clock2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="3dp" android:paddingBottom="3dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wc_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_clock3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
