<?xml version="1.0" encoding="utf-8"?>
<!-- 时区时钟, short: the first three clocks of 编辑看板 as name, weekday and time, each a TextClock in its own zone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/w_head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="20dp" android:layout_height="20dp" android:importantForAccessibility="no" />
        <TextView android:id="@+id/w_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="7dp" android:paddingEnd="6dp"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_meta" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
        <TextView android:id="@+id/wc_name1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_day1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:format24Hour="EEE" android:format12Hour="EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextClock android:id="@+id/wc_clock1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp">
        <TextView android:id="@+id/wc_name2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_day2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:format24Hour="EEE" android:format12Hour="EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextClock android:id="@+id/wc_clock2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
    <LinearLayout android:id="@+id/wc_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="5dp">
        <TextView android:id="@+id/wc_name3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:textSize="12sp" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end" />
        <TextClock android:id="@+id/wc_day3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:paddingEnd="6dp"
            android:format24Hour="EEE" android:format12Hour="EEE" android:textSize="11sp" android:textColor="@color/widget_faint" android:singleLine="true" />
        <TextClock android:id="@+id/wc_clock3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFeatureSettings="tnum"
            android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_ink" />
    </LinearLayout>
</LinearLayout>
