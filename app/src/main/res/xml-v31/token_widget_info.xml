<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: placed at 4 × 3 cells by default, room for every account; GodWidgets redraws for each size it is resized to. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="180dp" android:minResizeWidth="110dp" android:minResizeHeight="110dp"
    android:targetCellWidth="4" android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical" android:updatePeriodMillis="0" android:initialLayout="@layout/widget_waiting_tokens"
    android:description="@string/widget_tokens_description" android:widgetCategory="home_screen" />
