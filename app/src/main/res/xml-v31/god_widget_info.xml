<?xml version="1.0" encoding="utf-8"?>
<!-- keyguard lets Pixel's lock-screen widgets (Android 16 QPR2+) offer it; tapping there asks to unlock first.
     One row by two cells by default and never taller than about two rows, so the lock-screen hub keeps it small. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp" android:minHeight="40dp" android:minResizeWidth="110dp" android:minResizeHeight="40dp"
    android:maxResizeHeight="110dp" android:targetCellWidth="2" android:targetCellHeight="1"
    android:resizeMode="horizontal|vertical" android:updatePeriodMillis="0"
    android:initialLayout="@layout/god_widget" android:previewLayout="@layout/god_widget"
    android:description="@string/widget_description" android:widgetCategory="home_screen|keyguard" />
