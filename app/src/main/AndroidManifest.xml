<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET" />
 <!-- In-app update hands a verified APK of this same app to the system installer, which asks the person to confirm. -->
 <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
 <!-- Tibo 重置提醒: no Google push on the phone, so a foreground service and exact alarms read the alerts route every
      five minutes; a new announcement rings with the alarm sound and a full-screen page until it is acknowledged. -->
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
 <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
 <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
 <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
 <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
 <uses-permission android:name="android.permission.WAKE_LOCK" />
 <uses-permission android:name="android.permission.VIBRATE" />
 <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
 <!-- 心力球: the owner switches on all-day recording; a microphone foreground service keeps it going with the system
      microphone indicator and an ongoing notification. Audio and text stay in the app's private storage. -->
 <uses-permission android:name="android.permission.RECORD_AUDIO" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
 <!-- UU 远程: its version is checked (the protocol needs 4.42.0) and its uuremote:// links are opened. -->
 <queries>
  <package android:name="com.netease.uuremote" />
  <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="uuremote" /></intent>
 </queries>
 <application android:label="God" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="false" android:usesCleartextTraffic="false" android:supportsRtl="true">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
   <intent-filter android:autoVerify="true">
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="https" android:host="god.robby.wang" android:path="/mobile/android/callback"/>
   </intent-filter>
   <!-- UU 远程 returns bind and picture-in-picture results here; each carries the nonce God sent, others are dropped. -->
   <intent-filter>
    <action android:name="android.intent.action.VIEW"/>
    <category android:name="android.intent.category.DEFAULT"/><category android:name="android.intent.category.BROWSABLE"/>
    <data android:scheme="${applicationId}" android:host="uuremote"/>
   </intent-filter>
  </activity>
  <receiver android:name=".UpdateReceiver" android:exported="false" />
  <activity android:name=".TiboAlarmActivity" android:exported="false" android:showWhenLocked="true" android:turnScreenOn="true" android:launchMode="singleTask" android:taskAffinity="wang.robby.console.android.tibo" android:excludeFromRecents="true" />
  <service android:name=".TiboWatchService" android:exported="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Owner-enabled five-minute check of public reset announcements and the owner's own quota and site status. The foreground service runs only while that check is in progress and stops when it finishes; the device has no Google push." />
  </service>
  <!-- God 小组件 (home screen and lock screen) and the 快捷设置 tile: the app mark and public Tibo news; a tap opens God. -->
  <receiver android:name=".GodWidget" android:exported="true" android:label="God">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/god_widget_info"/>
  </receiver>
  <!-- Token 额度, 重置日历, 运行状态 and 微信消息 (home screen only) and 时区时钟 (also the lock screen): figures from reads God
       already made, with an account's email prefix but no whole email, account id, site or conversation name; signing out clears them. -->
  <receiver android:name=".TokenWidget" android:exported="true" android:label="Token 额度">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/token_widget_info"/>
  </receiver>
  <receiver android:name=".CalendarWidget" android:exported="true" android:label="重置日历">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/calendar_widget_info"/>
  </receiver>
  <receiver android:name=".ClockWidget" android:exported="true" android:label="时区时钟">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/clock_widget_info"/>
  </receiver>
  <receiver android:name=".StatusWidget" android:exported="true" android:label="运行状态">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/status_widget_info"/>
  </receiver>
  <receiver android:name=".WechatWidget" android:exported="true" android:label="微信消息">
   <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
   <meta-data android:name="android.appwidget.provider" android:resource="@xml/wechat_widget_info"/>
  </receiver>
  <service android:name=".GodTileService" android:exported="true" android:label="God" android:icon="@drawable/tab_home_solid" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
   <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
  </service>
  <service android:name=".MindBallService" android:exported="false" android:foregroundServiceType="microphone" />
  <receiver android:name=".TiboWatchReceiver" android:exported="false">
   <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED"/><action android:name="android.intent.action.MY_PACKAGE_REPLACED"/></intent-filter>
  </receiver>
 </application>
</manifest>
